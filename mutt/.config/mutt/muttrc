# vim: filetype=neomuttrc

startup-hook 'echo `touch "$HOME/.local/state/mutt-lastview"`'

# General
set mail_check = 120
set mail_check_stats
set sleep_time = 0              # Don't pause for informational messages
set wait_key = no               # Don't ask "press key to continue"
set rfc2047_parameters = yes

# MIME
set mailcap_path = $HOME/.config/mutt/mailcap:$mailcap_path
set mime_type_query_command = "file --mime-type -b %s"
auto_view text/html
auto_view application/pgp-encrypted
alternative_order text/plain text/enriched text/html

# Contacts
set query_command = "khard email --parsable %s"

# Index
set date_format = "%Y/%m/%d %I:%M%p"
set use_threads = yes
set sort = reverse-date
set sort_aux = date
set mark_old = no               # Unread mail stays unread until read

# Pager
set pager_context = 1
set pager_index_lines = 20
set pager_stop
set markers = no                # Don't show `+` at wrapped lines

# Compose
set fast_reply                  # Skip to compose when replying
set include                     # Quote message in replies
set reverse_name                # Reply as whomever it was to
set recall = no
set fcc_attach                  # Save attachments with the body
set forward_format = "Fwd: %s"
set forward_quote               # Quote message in forwards
set mime_forward = yes          # Forward attachments with the mail

source $HOME/.config/mutt/colors/void
source $HOME/.config/mutt/themes/void
source $HOME/.config/mutt/keymap
source $HOME/.config/mutt/accounts/$EMAIL.muttrc
